<controls:MetroWindow x:Class="TheRoad.CreadorPJWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                       xmlns:local="clr-namespace:TheRoad"
                       Title="The Road — Crear Superviviente"
                       Height="700" Width="1000"
                      MinHeight="620" MinWidth="880"
                      Background="{StaticResource BrushBgDark}"
                      Foreground="{StaticResource BrushTextPrimary}"
                       WindowStartupLocation="CenterScreen"
                      GlowBrush="{StaticResource BrushAccentGold}"
                      BorderThickness="1"
                      BorderBrush="{StaticResource BrushBorder}"
                      TitleForeground="{StaticResource BrushAccentGold}"
                      TitleAlignment="Left"
                      SaveWindowPosition="False"
                      ShowIconOnTitleBar="False">

    <controls:MetroWindow.RightWindowCommands>
        <controls:WindowCommands>
            <Button Content="⚙ Opciones" ToolTip="Opciones" Click="BtnOptions_Click" />
        </controls:WindowCommands>
    </controls:MetroWindow.RightWindowCommands>

    <Grid Background="{StaticResource BrushBgDarkest}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- IZQUIERDA: Formulario -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="24,16,12,16" Style="{StaticResource StyledScrollViewer}">
            <StackPanel>
                <!-- Título -->
                <TextBlock Text="CREAR SUPERVIVIENTE" Style="{StaticResource TitleTextBlock}" Margin="0,0,0,4" />
                <Separator Style="{StaticResource DecorativeSeparator}" Margin="0,0,0,8" />
<TextBlock Text="Washington D.C. — Elige quién intentará cruzar hasta la costa oeste."
                           Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,20" />

                <!-- Nombre -->
                <TextBlock Text="NOMBRE" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="20"
                         controls:TextBoxHelper.Watermark="Escribe tu nombre..."
                         controls:TextBoxHelper.ClearTextButton="True"
                         Style="{StaticResource StyledTextBox}" />

                <!-- Foto -->
                <TextBlock Text="FOTO (OPCIONAL)" Style="{StaticResource HeaderTextBlock}" Margin="0,16,0,8" />
                <Border Style="{StaticResource PanelBorder}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="140" Height="140" BorderBrush="{StaticResource BrushBorder}" BorderThickness="2"
                                Background="{StaticResource BrushBgDark}" CornerRadius="4"
                                Effect="{StaticResource ShadowMedium}">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,140,140" RadiusX="2" RadiusY="2" />
                            </Border.Clip>
                            <Image Source="{Binding PhotoPath}" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="🖼  Elegir foto..." Click="BtnFoto_Click"
                                    Style="{StaticResource BaseButton}" Width="200" Margin="0,0,0,8" />
                            <Button Content="✕  Quitar foto" Click="BtnQuitarFoto_Click"
                                    Style="{StaticResource BaseButton}" Width="200" Margin="0,0,0,8"
                                    Visibility="{Binding TieneFoto, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Formatos: JPG, PNG | Máx. 5 MB" Style="{StaticResource MonoTextBlock}" Opacity="0.6" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="O ELIGE UNA PREDISEÑADA" Style="{StaticResource HeaderTextBlock}" Margin="0,12,0,8" />
                <ItemsControl ItemsSource="{Binding Avatares}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="AvatarPreset_Click" Tag="{Binding Ruta}" ToolTip="{Binding Nombre}"
                                    Padding="2" Margin="0,0,8,8" Background="Transparent" BorderThickness="0">
                                <StackPanel>
                                    <Image Source="{Binding Ruta}" Width="56" Height="56" Stretch="UniformToFill" />
                                    <TextBlock Text="{Binding Nombre}" Style="{StaticResource MonoTextBlock}"
                                               FontSize="10" TextAlignment="Center" MaxWidth="64"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Stats -->
                <TextBlock Text="HABILIDADES" Style="{StaticResource HeaderTextBlock}" Margin="0,16,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Puntos disponibles: " />
                    <TextBlock Text="{Binding PuntosRestantes}" Style="{StaticResource StatValueTextBlock}" Foreground="{StaticResource BrushAccentGold}" FontSize="20" />
                    <TextBlock Text=" / 8" Opacity="0.7" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
                <TextBlock Text="Base 1, máximo 5. Reparte todos los puntos para continuar."
                           Opacity="0.6" Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding StatRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,6" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Nombre stat + tooltip -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="15" VerticalAlignment="Center"
                                                   ToolTip="{Binding Description}" />
                                    </StackPanel>

                                    <!-- Barra visual de 5 segmentos -->
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Segments}" VerticalAlignment="Center" Margin="16,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="28" Height="18" Margin="2,0" CornerRadius="2"
                                                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                        Background="{Binding IsFilled, Converter={StaticResource BoolToSegmentBrush}}"
                                                        Effect="{Binding IsFilled, Converter={StaticResource BoolToGlowEffect}}">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform CenterX="14" CenterY="9" ScaleX="1" ScaleY="1" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Controles + valor -->
                                    <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="−" Tag="{Binding Name}" Click="BtnMenos_Click"
                                                Style="{StaticResource GridButton}" Width="32" Height="32"
                                                ToolTip="Disminuir" IsEnabled="{Binding CanDecrease}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource StatValueTextBlock}"
                                                   Foreground="{StaticResource BrushAccentGold}" />
                                        <Button Grid.Column="2" Content="+" Tag="{Binding Name}" Click="BtnMas_Click"
                                                Style="{StaticResource GridButton}" Width="32" Height="32"
                                                ToolTip="Aumentar" IsEnabled="{Binding CanIncrease}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Error -->
                <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrushAccentRust}"
                           TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="24" />

                <!-- Botones acción -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="🎲 Aleatorio" Click="BtnAleatorio_Click" Style="{StaticResource BaseButton}" Width="140" Margin="0,0,10,0" />
                    <Button Content="↻ Reiniciar" Click="BtnReiniciar_Click" Style="{StaticResource BaseButton}" Width="140" Margin="0,0,10,0" />
                    <Button x:Name="BtnDebug" Content="⚡ Debug: Ir al HUD" Click="BtnDebug_Click"
                            Style="{StaticResource BaseButton}" Width="180"
                            Visibility="Collapsed" Background="#3A2E12" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- DERECHA: Resumen -->
        <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="12,16,24,16" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource StyledScrollViewer}">
                <StackPanel>
                    <TextBlock Text="RESUMEN DEL PERSONAJE" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,8" />
                    <Separator Style="{StaticResource DecorativeSeparator}" Margin="0,0,0,16" />

                    <!-- Foto grande -->
                    <Border Width="220" Height="220" BorderBrush="{StaticResource BrushBorder}" BorderThickness="2"
                            Background="{StaticResource BrushBgDark}" CornerRadius="4"
                            Effect="{StaticResource ShadowLarge}" Margin="0,0,0,16"
                            HorizontalAlignment="Center">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,220,220" RadiusX="2" RadiusY="2" />
                        </Border.Clip>
                        <Image Source="{Binding PhotoPath}" Stretch="UniformToFill" />
                    </Border>

                    <TextBlock Text="{Binding Nombre, StringFormat='Nombre: {0}'}"
                               FontSize="18" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />

                    <!-- Stats con descripción -->
                    <ItemsControl ItemsSource="{Binding StatRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,4" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MonoTextBlock}" FontSize="9" Opacity="0.7" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource StatValueTextBlock}"
                                                   Foreground="{StaticResource BrushAccentGold}" FontSize="20" Width="45" TextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="🚗 COMENZAR VIAJE" Click="BtnComenzar_Click"
                            IsEnabled="{Binding PuedeComenzar}"
                            Style="{StaticResource PrimaryButton}"
                            Height="50" FontSize="16" Margin="0,20,0,0"
                            Effect="{StaticResource ShadowGlowGold}" />

                    <TextBlock Text="Reparte todos los puntos y pon nombre para continuar."
                               Opacity="0.55" FontSize="11"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</controls:MetroWindow>