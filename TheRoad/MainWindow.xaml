<Window x:Class="TheRoad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Road — Crear superviviente" Height="620" Width="880"
        MinHeight="560" MinWidth="760"
        Background="#141414" Foreground="#E8E0D0" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E0D0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="Foreground" Value="#E8E0D0"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#E8E0D0"/>
            <Setter Property="BorderBrush" Value="#666"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Izquierda: formulario -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="CREAR SUPERVIVIENTE" FontSize="22" FontWeight="Bold" Foreground="#D8A545"/>
                <TextBlock Text="Washington D.C. — elige quién intentará cruzar hasta Los Ángeles."
                           TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,12"/>

                <TextBlock Text="Nombre" FontWeight="Bold"/>
                <TextBox x:Name="TxtNombre" MaxLength="20"
                         Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Foto (opcional)" FontWeight="Bold" Margin="0,12,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Border Width="120" Height="120" BorderBrush="#666" BorderThickness="1" Background="#222">
                        <Image Source="{Binding PhotoPath}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Content="Elegir foto..." Click="BtnFoto_Click"/>
                        <Button Content="Quitar" Click="BtnQuitarFoto_Click"/>
                        <TextBlock Text="JPG / PNG" Opacity="0.6" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                    <TextBlock Text="Habilidades" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding PuntosRestantes, StringFormat='  (puntos: {0})'}"
                               Foreground="#D8A545" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
                <TextBlock Text="Base 1, máximo 5. Reparte los 8 puntos."
                           Opacity="0.7" Margin="0,0,0,6"/>

                <!-- 6 filas de stats. Simples y explícitas, sin templates. -->
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="30"/><ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Fuerza" VerticalAlignment="Center"
                               ToolTip="Combate cuerpo a cuerpo y mover obstáculos."/>
                    <Button Grid.Column="1" Content="-" Tag="Fuerza" Click="BtnMenos_Click"/>
                    <TextBlock Grid.Column="2" Text="{Binding Fuerza}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button Grid.Column="3" Content="+" Tag="Fuerza" Click="BtnMas_Click"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="30"/><ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Destreza" VerticalAlignment="Center"
                               ToolTip="Huir, sigilo y acciones rápidas."/>
                    <Button Grid.Column="1" Content="-" Tag="Destreza" Click="BtnMenos_Click"/>
                    <TextBlock Grid.Column="2" Text="{Binding Destreza}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button Grid.Column="3" Content="+" Tag="Destreza" Click="BtnMas_Click"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="30"/><ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Resistencia" VerticalAlignment="Center"
                               ToolTip="Aguantar hambre, heridas y marchas largas."/>
                    <Button Grid.Column="1" Content="-" Tag="Resistencia" Click="BtnMenos_Click"/>
                    <TextBlock Grid.Column="2" Text="{Binding Resistencia}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button Grid.Column="3" Content="+" Tag="Resistencia" Click="BtnMas_Click"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="30"/><ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Inteligencia" VerticalAlignment="Center"
                               ToolTip="Medicina, mecánica y resolver problemas."/>
                    <Button Grid.Column="1" Content="-" Tag="Inteligencia" Click="BtnMenos_Click"/>
                    <TextBlock Grid.Column="2" Text="{Binding Inteligencia}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button Grid.Column="3" Content="+" Tag="Inteligencia" Click="BtnMas_Click"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="30"/><ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Percepción" VerticalAlignment="Center"
                               ToolTip="Detectar peligros y encontrar recursos."/>
                    <Button Grid.Column="1" Content="-" Tag="Percepcion" Click="BtnMenos_Click"/>
                    <TextBlock Grid.Column="2" Text="{Binding Percepcion}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button Grid.Column="3" Content="+" Tag="Percepcion" Click="BtnMas_Click"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="30"/><ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Carisma" VerticalAlignment="Center"
                               ToolTip="Persuadir y comerciar con otros supervivientes."/>
                    <Button Grid.Column="1" Content="-" Tag="Carisma" Click="BtnMenos_Click"/>
                    <TextBlock Grid.Column="2" Text="{Binding Carisma}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button Grid.Column="3" Content="+" Tag="Carisma" Click="BtnMas_Click"/>
                </Grid>

                <TextBlock Text="{Binding MensajeError}" Foreground="#E07A5F"
                           TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="20"/>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Aleatorio" Click="BtnAleatorio_Click"/>
                    <Button Content="Reiniciar" Click="BtnReiniciar_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Derecha: resumen -->
        <Border Grid.Column="1" BorderBrush="#555" BorderThickness="1" Background="#1E1E1E" Padding="14">
            <StackPanel>
                <TextBlock Text="RESUMEN" FontWeight="Bold" Foreground="#D8A545" FontSize="16"/>
                <Border Width="180" Height="180" BorderBrush="#666" BorderThickness="1"
                        Background="#222" Margin="0,10" HorizontalAlignment="Center">
                    <Image Source="{Binding PhotoPath}" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="{Binding Nombre, StringFormat='Nombre: {0}'}" TextWrapping="Wrap" FontWeight="Bold"/>
                <TextBlock Text="{Binding Fuerza, StringFormat='Fuerza: {0} — cuerpo a cuerpo, obstáculos.'}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Destreza, StringFormat='Destreza: {0} — huir, sigilo.'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Resistencia, StringFormat='Resistencia: {0} — hambre, heridas.'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Inteligencia, StringFormat='Inteligencia: {0} — medicina, mecánica.'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Percepcion, StringFormat='Percepción: {0} — peligros, recursos.'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Carisma, StringFormat='Carisma: {0} — persuadir, comerciar.'}" TextWrapping="Wrap"/>

                <Button Content="Comenzar viaje" Click="BtnComenzar_Click"
                        IsEnabled="{Binding PuedeComenzar}"
                        Background="#5A4A1F" FontWeight="Bold" Margin="0,16,0,0" Padding="10"/>
                <TextBlock Text="Reparte todos los puntos y pon nombre para continuar."
                           Opacity="0.6" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
