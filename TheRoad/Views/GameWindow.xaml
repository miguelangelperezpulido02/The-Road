<controls:MetroWindow x:Class="TheRoad.Views.GameWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:views="clr-namespace:TheRoad.Views"
                      xmlns:vm="clr-namespace:TheRoad.ViewModels"
                      xmlns:conv="clr-namespace:TheRoad.Converters"
                      Title="The Road — Partida"
                      Height="720" Width="1280"
                      MinHeight="640" MinWidth="960"
                      Background="{StaticResource BrushBgDark}"
                      Foreground="{StaticResource BrushTextPrimary}"
                      WindowStartupLocation="CenterScreen"
                      GlowBrush="{StaticResource BrushAccentGold}"
                      BorderThickness="1"
                      BorderBrush="{StaticResource BrushBorder}"
                      TitleForeground="{StaticResource BrushAccentGold}"
                       TitleAlignment="Left"
                       SaveWindowPosition="False"
                      ShowIconOnTitleBar="False">

    <controls:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Converters/CommonConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:MetroWindow.Resources>

    <controls:MetroWindow.RightWindowCommands>
        <controls:WindowCommands>
            <Button Content="⚙ Opciones" Click="BtnOptions_Click" ToolTip="Opciones" />
            <Button Content="💾 Guardar" Click="BtnSave_Click" ToolTip="Guardar partida" />
        </controls:WindowCommands>
    </controls:MetroWindow.RightWindowCommands>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- Central -->
            <ColumnDefinition Width="320" />
            <!-- Sidebar: Estado personaje -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header HUD -->
            <RowDefinition Height="*" />
            <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             HEADER HUD - Siempre visible
             ============================================================ -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="12,12,12,8" Padding="12,8" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- Día / Ubicación -->
                    <ColumnDefinition Width="*" />
                    <!-- Barras de recursos (wrap, alineadas a la derecha) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Alertas -->
                </Grid.ColumnDefinitions>

                <!-- Día y Ubicación -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DiaActual}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentGold}"
                               Effect="{StaticResource ShadowGlowGold}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  │  " Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" FontSize="16" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="📍" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding LugarActual.Name}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   MaxWidth="360"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Barras de Recursos (se adaptan al ancho disponible) -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding ResourceBars}"
                              VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="150" Margin="6,0,0,0" ToolTip="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="15"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="8"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1" Value="{Binding Value, Mode=OneWay}" Maximum="{Binding MaxValue}"
                                                     Height="16" Style="{StaticResource ResourceProgressBar}"
                                                     Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"
                                                     VerticalAlignment="Center" />
                                         <TextBlock Grid.Column="2" Text="{Binding DisplayText}"
                                                    FontFamily="{StaticResource FontMono}" FontSize="11"
                                                    Foreground="{StaticResource BrushTextSecondary}"
                                                    VerticalAlignment="Center" Margin="0,0,0,0"
                                                    MinWidth="52" TextAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Indicador de alerta -->
                <Border Grid.Column="2" x:Name="AlertIndicator"
                        Width="24" Height="24"
                        CornerRadius="12"
                        Background="{StaticResource BrushAccentMoss}"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Visibility="Collapsed"
                        ToolTip="Alerta: recursos bajos">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.3" Duration="0:0:1"
                                                     AutoReverse="True" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <TextBlock Text="!" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource BrushBgDarkest}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================
             MAIN CONTENT AREA
             ============================================================ -->
        <Grid Grid.Row="1" Margin="12,0,12,12" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- Central: Vista/Mapa/Diario -->
                <ColumnDefinition Width="320" />
                <!-- Sidebar: Estado personaje -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- Contenido -->
                <RowDefinition Height="Auto" />
                <!-- Barra debug (0 alto en Release) -->
            </Grid.RowDefinitions>

            <!-- CENTRAL PANEL -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                <Grid>
                    <!-- Tab Buttons -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,2" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Vista" GroupName="ViewTabs"
                                         IsChecked="{Binding Vista, Converter={StaticResource StringToBool}, ConverterParameter=Vista}"
                                         Style="{StaticResource TabRadioButton}" Margin="5,0,0,0"/>
                            <RadioButton Content="🗺 MAPA" GroupName="ViewTabs"
                                         IsChecked="{Binding Vista, Converter={StaticResource StringToBool}, ConverterParameter=Mapa}"
                                         Style="{StaticResource TabRadioButton}" Margin="5,0,0,0" />
                            <RadioButton Content="📓 DIARIO" GroupName="ViewTabs"
                                         IsChecked="{Binding Vista, Converter={StaticResource StringToBool}, ConverterParameter=Diario}"
                                         Style="{StaticResource TabRadioButton}" Margin="5,0,0,0" />
                            <RadioButton Content="🚗 VEHÍCULO" GroupName="ViewTabs"
                                         IsChecked="{Binding Vista, Converter={StaticResource StringToBool}, ConverterParameter=Vehiculo}"
                                         Style="{StaticResource TabRadioButton}" Margin="5,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Content -->
                    <Grid Grid.Row="1">
                        <!-- VISTA -->
                        <ScrollViewer x:Name="PanelVista"
                                      Visibility="{Binding Vista, Converter={StaticResource StringToVis}, ConverterParameter=Vista}"
                                      VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource StyledScrollViewer}"
                                      Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="NARRATIVA" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,8" />
                                <Separator Style="{StaticResource DecorativeSeparator}" Margin="0,0,0,135" />

                                <Border x:Name="NarrativeBorder" Style="{StaticResource PanelBorder}" Padding="16">
                                    <TextBlock x:Name="NarrativeText"
                                               Text="{Binding Narrativa}"
                                               FontSize="14"
                                               LineHeight="22"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- Modo de Viaje -->
                                <StackPanel Margin="0,16,0,8">
                                    <TextBlock Text="MODO DE VIAJE" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="🛣 Autopista (larga)"
                                                     GroupName="TravelMode"
                                                     IsChecked="{Binding EsAutopista}"
                                                     Style="{StaticResource TabRadioButton}"
                                                     ToolTip="Un solo tramo: más gasolina, viaje sin paradas, eventos grandes." />
                                        <RadioButton Content="🛤 Secundaria (segmentada)"
                                                     GroupName="TravelMode"
                                                     IsChecked="{Binding EsSecundaria}"
                                                     Style="{StaticResource TabRadioButton}"
                                                     Margin="12,0,0,0"
                                                     ToolTip="Por paradas: poca gasolina por tramo, paras en cada parada, eventos menores + chapuceo." />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Opciones Destino -->
                                <StackPanel Margin="0,12,0,8">
                                    <TextBlock Text="DESTINOS DISPONIBLES" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,8" />
                                    <ListBox x:Name="ListaOpciones"
                                             ItemsSource="{Binding Opciones}"
                                             SelectedItem="{Binding OpcionSeleccionada}"
                                             Style="{StaticResource StyledListBox}"
                                             Height="160"
                                             BorderBrush="{StaticResource BrushBorder}"
                                             BorderThickness="1"
                                             Background="{StaticResource BrushBgDark}" />
                                </StackPanel>

                                <Button Content="🚗 VIAJAR AL DESTINO"
                                        Click="BtnViajar_Click"
                                        IsEnabled="{Binding PuedeViajar}"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="44"
                                        FontSize="14"
                                        Margin="0,8,0,0"
                                        Effect="{StaticResource ShadowGlowGold}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- MAPA -->
                        <Border x:Name="PanelMapa"
                                Visibility="{Binding Vista, Converter={StaticResource StringToVis}, ConverterParameter=Mapa}"
                                Background="Transparent">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource StyledScrollViewer}">
                                <views:MapView x:Name="VistaMapa" />
                            </ScrollViewer>
                        </Border>

                        <!-- DIARIO -->
                        <ScrollViewer x:Name="PanelDiario"
                                      Visibility="{Binding Vista, Converter={StaticResource StringToVis}, ConverterParameter=Diario}"
                                      VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource StyledScrollViewer}"
                                      Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="DIARIO DE VIAJE" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,8" />
                                <Separator Style="{StaticResource DecorativeSeparator}" Margin="0,0,0,12" />
                                <ListBox ItemsSource="{Binding Diario}"
                                         Style="{StaticResource StyledListBox}"
                                         BorderBrush="{StaticResource BrushBorder}"
                                         BorderThickness="1"
                                         Background="{StaticResource BrushBgDark}"
                                         MinHeight="400">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4" Background="Transparent">
                                                <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- VEHÍCULO -->
                        <ScrollViewer x:Name="PanelVehiculo"
                                      Visibility="{Binding Vista, Converter={StaticResource StringToVis}, ConverterParameter=Vehiculo}"
                                      VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource StyledScrollViewer}"
                                      Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="VEHÍCULO" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,8" />
                                <Separator Style="{StaticResource DecorativeSeparator}" Margin="0,0,0,12" />

                                <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,12"
                                        HorizontalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/Images/Icons/vehiculo.png"
                                           Width="160" Height="160" Stretch="Uniform" />
                                </Border>

                                <Border Style="{StaticResource PanelBorder}" Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="ESTADO" Style="{StaticResource MonoTextBlock}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding VehiculoTexto}"
                                                       Style="{StaticResource MonoTextBlock}" FontSize="12"
                                                       Foreground="{StaticResource BrushAccentGold}" />
                                        </Grid>
                                        <ProgressBar Value="{Binding VehiculoEstado, Mode=OneWay}" Maximum="100" Height="10"
                                                     Style="{StaticResource ResourceProgressBar}"
                                                     Foreground="{StaticResource BrushAccentGold}"
                                                     Margin="0,0,0,4" />

                                        <Grid Margin="0,0,0,12"
                                              ToolTip="Probabilidad de avería en el próximo viaje según la salud del vehículo.">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="PROB. AVERÍA" Style="{StaticResource MonoTextBlock}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding ProbabilidadAveriaTexto}"
                                                       Style="{StaticResource MonoTextBlock}" FontSize="12"
                                                       Foreground="{StaticResource BrushAccentGold}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="COMBUSTIBLE" Style="{StaticResource MonoTextBlock}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding ResourceBars[3].DisplayText}"
                                                       Style="{StaticResource MonoTextBlock}" FontSize="12"
                                                       Foreground="{StaticResource BrushAccentGold}" />
                                        </Grid>
                                        <ProgressBar Value="{Binding ResourceBars[3].Value, Mode=OneWay}" Maximum="100" Height="10"
                                                     Style="{StaticResource ResourceProgressBar}"
                                                     Foreground="{StaticResource BrushAccentGold}"
                                                     Margin="0,0,0,12" />

                                        <TextBlock Margin="0,0,0,12"
                                                   Style="{StaticResource MonoTextBlock}" FontSize="12">
                                            <Run Text="⚙ Chatarra: " /><Run Text="{Binding ChatarraCount, Mode=OneWay}" Foreground="{StaticResource BrushAccentGold}" />
                                        </TextBlock>

                                        <Button Content="🔧 REPARAR (+20)"
                                                Click="BtnReparar_Click"
                                                IsEnabled="{Binding PuedeReparar}"
                                                Style="{StaticResource PrimaryButton}"
                                                Height="40" FontSize="13" />

                                        <TextBlock Text="Cada chatarra repara +20 (máx. 100). A 0 el coche no anda."
                                                   Style="{StaticResource MonoTextBlock}"
                                                   FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- SIDEBAR: ESTADO PERSONAJE -->
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource StyledScrollViewer}">
                    <StackPanel>
                        <!-- Foto y Nombre -->
                        <Border Width="112" Height="112"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="2"
                                Background="{StaticResource BrushBgDark}" CornerRadius="4"
                                Effect="{StaticResource ShadowLarge}" Margin="0,0,0,8"
                                HorizontalAlignment="Center">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,112,112" RadiusX="2" RadiusY="2" />
                            </Border.Clip>
                            <Image Source="{Binding Foto}" Stretch="UniformToFill" />
                        </Border>

                        <TextBlock Text="{Binding NombreJugador}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />

                        <TextBlock Text="{Binding NivelJugador, StringFormat='Nivel {0}'}"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,0,0,8" />

                        <!-- Info Destino -->
                        <Border Style="{StaticResource PanelBorder}" Margin="0,8,0,0" Padding="12">
                            <TextBlock Text="{Binding InfoDestino}"
                                       FontSize="12"
                                       Opacity="0.85"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- INVENTORY GRID (8x8) -->
                        <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="INVENTARIO" Style="{StaticResource HeaderTextBlock}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding InventoryUsed, StringFormat='Usados: {0}'}"
                                                   Style="{StaticResource MonoTextBlock}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding InventoryCapacity, StringFormat='/ {0}'}"
                                                   Style="{StaticResource MonoTextBlock}" FontSize="10" VerticalAlignment="Center" Opacity="0.6" />
                                        <ProgressBar Width="80" Height="6"
                                                     Value="{Binding InventoryFillRatio, Mode=OneWay}" Maximum="1"
                                                     Style="{StaticResource ResourceProgressBar}"
                                                     Foreground="{StaticResource BrushAccentGold}"
                                                     VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Row="1" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                        Background="{StaticResource BrushBgDark}" CornerRadius="3">
                                    <ItemsControl ItemsSource="{Binding InventoryItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="8" Columns="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding Name}"
                                                        Click="BtnUsarItem_Click"
                                                        Padding="0"
                                                        Margin="1"
                                                        ToolTip="{Binding Name}"
                                                        IsEnabled="{Binding IsUsable}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Border"
                                                                    Background="#26261A"
                                                                    BorderBrush="{StaticResource BrushBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2"
                                                                    SnapsToDevicePixels="True">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Text="{Binding Icon}"
                                                                               FontSize="13"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Row="1"
                                                                               Text="{Binding CountText}"
                                                                               FontFamily="{StaticResource FontMono}"
                                                                               FontSize="8"
                                                                               Foreground="{StaticResource BrushAccentGold}"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Bottom"
                                                                               Margin="0,0,2,1" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <!-- Hueco vacío: celda oscura de la rejilla -->
                                                                <DataTrigger Binding="{Binding Name}" Value="">
                                                                    <Setter TargetName="Border" Property="Background" Value="#141410" />
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#2E2E26" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushAccentGold}" />
                                                                    <Setter TargetName="Border" Property="Background" Value="#33331F" />
                                                                </Trigger>
                                                                <!-- Objeto no consumible: sigue ocupando su hueco, solo ligeramente atenuado -->
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="Border" Property="Opacity" Value="0.85" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- Empty slots indicator -->
                                <TextBlock Grid.Row="1"
                                           Text="Clic en objeto usable para consumirlo."
                                           Style="{StaticResource MonoTextBlock}"
                                           FontSize="9"
                                           Opacity="0.5"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- BARRA DEBUG: solo visible en builds DEBUG (EsDebugBuild) -->
            <Border Grid.Row="1" Grid.ColumnSpan="2"
                    Visibility="{Binding EsDebugBuild, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource PanelBorder}"
                    Padding="8,6" Margin="0,8,0,0">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="[DEBUG]" Style="{StaticResource MonoTextBlock}" FontSize="11"
                               Foreground="{StaticResource BrushAccentRust}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Forzar avería" Tag="averia" Click="Dbg_Click"
                            Style="{StaticResource BaseButton}" Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Aplica -10 de salud y abre el popup de avería" />
                    <Button Content="Salud 100" Tag="s100" Click="Dbg_Click"
                            Style="{StaticResource BaseButton}" Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Vehículo al 100%: probabilidad 0%" />
                    <Button Content="Salud 50" Tag="s50" Click="Dbg_Click"
                            Style="{StaticResource BaseButton}" Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Vehículo al 50%: probabilidad 15%" />
                    <Button Content="Salud 1" Tag="s1" Click="Dbg_Click"
                            Style="{StaticResource BaseButton}" Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Vehículo casi muerto: probabilidad casi máxima" />
                    <Button Content="Salud 0" Tag="s0" Click="Dbg_Click"
                            Style="{StaticResource BaseButton}" Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Vehículo roto: viajar bloqueado, probabilidad 30%" />
                    <Button Content="Tirada avería" Tag="tirada" Click="Dbg_Click"
                            Style="{StaticResource BaseButton}" Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Tira la probabilidad actual y enseña el resultado (sin daño)" />
                    <Button Content="🎲 Evento grande" Tag="eventoG" Click="Dbg_Click"
                            Style="{StaticResource BaseButton}" Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Fuerza un evento grande real del pool (efectos aplicados)" />
                    <Button Content="🎲 Evento menor" Tag="eventoM" Click="Dbg_Click"
                            Style="{StaticResource BaseButton}" Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Fuerza un evento menor real del pool (efectos aplicados)" />
                    <Button Content="🎲 Decisión" Tag="decisionD" Click="Dbg_Click"
                            Style="{StaticResource BaseButton}" Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Fuerza la gasolinera (elige opción; sin diario)" />
                    <Button Content="+20 gasolina" Tag="gas" Click="Dbg_Click"
                            Style="{StaticResource BaseButton}" Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0" />
                    <Button Content="+Bidón" Tag="bidon" Click="Dbg_Click"
                            Style="{StaticResource BaseButton}" Height="26" FontSize="11" Padding="10,0" />
                </WrapPanel>
            </Border>
        </Grid>

        <!-- ============================================================
             NOTIFICATIONS TOAST (Top-Right Overlay)
             ============================================================ -->
        <ItemsControl Grid.Row="1"
                       ItemsSource="{Binding Notifications}"
                       Panel.ZIndex="1000"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="20,28,0,0" Grid.Column="0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PanelBorder}"
                            Padding="12,8"
                            Margin="0,0,0,6"
                            MinWidth="280"
                            MaxWidth="360"
                            Effect="{StaticResource ShadowLarge}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ToastTransform" X="400" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ToastTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="400" To="0"
                                                         Duration="0:0:0.3"
                                                         DecelerationRatio="0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Type, Converter={StaticResource NotificationTypeToIcon}}"
                                       FontSize="16" VerticalAlignment="Top" Margin="0,0,8,0"
                                       Foreground="{Binding Type, Converter={StaticResource NotificationTypeToColor}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Travel Animation Overlay -->
        <Border x:Name="TravelOverlay"
                Grid.Row="0" Grid.RowSpan="2"
                Background="#800D0D0D"
                Visibility="Collapsed"
                Panel.ZIndex="500" Grid.ColumnSpan="2">
            <Grid>
                <Border Style="{StaticResource PanelBorder}" Padding="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MinWidth="300">
                    <StackPanel>
                        <TextBlock Text="🚗 VIAJANDO..."
                                   Style="{StaticResource TitleTextBlock}"
                                   TextAlignment="Center"
                                   FontFamily="{StaticResource FontMono}" />
                        <ProgressBar x:Name="TravelProgressBar"
                                      Value="{Binding TravelProgress, Mode=OneWay}"
                                      Maximum="1"
                                      Height="8"
                                      Style="{StaticResource ResourceProgressBar}"
                                      Foreground="{StaticResource BrushAccentGold}"
                                      Margin="0,16,0,0" />
                        <TextBlock x:Name="TravelStatusText"
                                   Text="Iniciando viaje..."
                                   TextAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- POP UP DEBUG genérico: título/texto enlazados; solo se dispara desde código DEBUG -->
        <Border x:Name="PopupOverlay"
                Grid.Row="0" Grid.RowSpan="2"
                Background="#800D0D0D"
                Visibility="{Binding PopupVisible, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="600" Grid.ColumnSpan="2">
            <Grid>
                <Border Style="{StaticResource PanelBorder}" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MinWidth="380" MaxWidth="560">
                    <StackPanel>
                        <TextBlock Text="{Binding PopupTitulo}"
                                   Style="{StaticResource TitleTextBlock}"
                                   TextAlignment="Center"
                                   FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushAccentRust}" />
                        <Separator Style="{StaticResource DecorativeSeparator}" Margin="0,10" />
                        <TextBlock Text="{Binding PopupTexto}"
                                   FontSize="13"
                                   LineHeight="20"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,16" />
                        <ItemsControl ItemsSource="{Binding OpcionesDecision}"
                                      Visibility="{Binding HayDecision, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Titulo}"
                                            Tag="{Binding Indice}"
                                            Click="BtnOpcionDecision_Click"
                                            Margin="0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="ENTENDIDO"
                                Visibility="{Binding SinDecision, Converter={StaticResource BoolToVis}}"
                                Click="BtnCerrarPopup_Click"
                                Style="{StaticResource PrimaryButton}"
                                Height="36"
                                FontSize="13"
                                MinWidth="180"
                                HorizontalAlignment="Center"
                                Effect="{StaticResource ShadowGlowGold}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</controls:MetroWindow>