<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         PALETA DIESELPUNK POST-APOC
         ============================================================ -->
    <Color x:Key="ColorBgDarkest">#0D0D0D</Color>
    <Color x:Key="ColorBgDark">#141414</Color>
    <Color x:Key="ColorBgPanel">#1E1E1E</Color>
    <Color x:Key="ColorBgPanelLight">#2A2A22</Color>
    <Color x:Key="ColorBorder">#3A3A30</Color>
    <Color x:Key="ColorBorderLight">#4A4A3E</Color>
    <Color x:Key="ColorTextPrimary">#E8E0D0</Color>
    <Color x:Key="ColorTextSecondary">#B8B0A0</Color>
    <Color x:Key="ColorTextMuted">#888070</Color>
    <Color x:Key="ColorAccentGold">#D8A545</Color>
    <Color x:Key="ColorAccentGoldDark">#B88525</Color>
    <Color x:Key="ColorAccentGoldLight">#F0C565</Color>
    <Color x:Key="ColorAccentRust">#E07A5F</Color>
    <Color x:Key="ColorAccentRustDark">#C05A3F</Color>
    <Color x:Key="ColorAccentMoss">#6B8E5C</Color>
    <Color x:Key="ColorAccentMossDark">#4B6E3C</Color>
    <Color x:Key="ColorAccentSteel">#5A6A7A</Color>
    <Color x:Key="ColorWarning">#D84545</Color>
    <Color x:Key="ColorCritical">#A83030</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBgDarkest" Color="{StaticResource ColorBgDarkest}" />
    <SolidColorBrush x:Key="BrushBgDark" Color="{StaticResource ColorBgDark}" />
    <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource ColorBgPanel}" />
    <SolidColorBrush x:Key="BrushBgPanelLight" Color="{StaticResource ColorBgPanelLight}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushAccentGold" Color="{StaticResource ColorAccentGold}" />
    <SolidColorBrush x:Key="BrushAccentGoldDark" Color="{StaticResource ColorAccentGoldDark}" />
    <SolidColorBrush x:Key="BrushAccentGoldLight" Color="{StaticResource ColorAccentGoldLight}" />
    <SolidColorBrush x:Key="BrushAccentRust" Color="{StaticResource ColorAccentRust}" />
    <SolidColorBrush x:Key="BrushAccentRustDark" Color="{StaticResource ColorAccentRustDark}" />
    <SolidColorBrush x:Key="BrushAccentMoss" Color="{StaticResource ColorAccentMoss}" />
    <SolidColorBrush x:Key="BrushAccentMossDark" Color="{StaticResource ColorAccentMossDark}" />
    <SolidColorBrush x:Key="BrushAccentSteel" Color="{StaticResource ColorAccentSteel}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushCritical" Color="{StaticResource ColorCritical}" />

    <!-- MahApps.Metro compatible brush keys (override any Color defaults) -->
    <SolidColorBrush x:Key="MahApps.Brushes.Text" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle" Color="{StaticResource ColorAccentGold}" />
    <SolidColorBrush x:Key="MahApps.Brushes.IdealForegroundColorBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="MahApps.Brushes.IdealForegroundDisabledBrush" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="MahApps.Brushes.Gray1" Color="#1A1A1A" />
    <SolidColorBrush x:Key="MahApps.Brushes.Gray2" Color="#2A2A2A" />
    <SolidColorBrush x:Key="MahApps.Brushes.Gray3" Color="#3A3A3A" />
    <SolidColorBrush x:Key="MahApps.Brushes.Gray4" Color="#4A4A4A" />
    <SolidColorBrush x:Key="MahApps.Brushes.Gray5" Color="#5A5A5A" />
    <SolidColorBrush x:Key="MahApps.Brushes.Gray6" Color="#6A6A6A" />
    <SolidColorBrush x:Key="MahApps.Brushes.Gray7" Color="#7A7A7A" />
    <SolidColorBrush x:Key="MahApps.Brushes.Gray8" Color="#8A8A8A" />
    <SolidColorBrush x:Key="MahApps.Brushes.Gray9" Color="#9A9A9A" />
    <SolidColorBrush x:Key="MahApps.Brushes.Gray10" Color="#AAAAAA" />
    <!-- Claves que las plantillas de MahApps (botones min/max/cerrar, comandos de ventana)
         esperan y que no vienen de ningún tema base: sin ellas el hover/pulsado escribe
         null y el estado visual se queda "pillado". Glifos oscuros sobre barra dorada. -->
    <SolidColorBrush x:Key="MahApps.Brushes.Transparent" Color="Transparent" />
    <SolidColorBrush x:Key="MahApps.Brushes.ThemeForeground" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="MahApps.Brushes.IdealForeground" Color="#1A1512" />
    <SolidColorBrush x:Key="MahApps.Brushes.IdealForegroundDisabled" Color="#7A6A55" />
    <SolidColorBrush x:Key="MahApps.Brushes.AccentBase" Color="{StaticResource ColorAccentGoldDark}" />
    <SolidColorBrush x:Key="MahApps.Brushes.WindowButtonCommands.Background.MouseOver" Color="#40000000" />

    <!-- Also provide non-namespaced fallbacks -->
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="WindowTitleBrush" Color="{StaticResource ColorAccentGold}" />
    <SolidColorBrush x:Key="IdealForegroundColorBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="IdealForegroundDisabledBrush" Color="{StaticResource ColorTextMuted}" />

    <!-- Gradientes para paneles con textura "metal/papel" -->
    <LinearGradientBrush x:Key="BrushPanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E1E1E" Offset="0" />
        <GradientStop Color="#1A1A16" Offset="0.5" />
        <GradientStop Color="#141410" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A2A22" Offset="0" />
        <GradientStop Color="#1E1E18" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushButtonHoverGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A3A2A" Offset="0" />
        <GradientStop Color="#2E2E22" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushButtonPressedGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E1E18" Offset="0" />
        <GradientStop Color="#141410" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGoldGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8C565" Offset="0" />
        <GradientStop Color="#D8A545" Offset="0.5" />
        <GradientStop Color="#B88525" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================
         FUENTES
         ============================================================ -->
    <FontFamily x:Key="FontMain">pack://application:,,,/Assets/Fonts/#Orbitron</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>
    <FontFamily x:Key="FontUI">pack://application:,,,/Assets/Fonts/#Orbitron</FontFamily>

    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeNormal">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeHuge">32</sys:Double>
    <sys:Double x:Key="FontSizeMonoSmall">9</sys:Double>
    <sys:Double x:Key="FontSizeMonoNormal">11</sys:Double>

    <!-- ============================================================
         SOMBRAS Y EFECTOS
         ============================================================ -->
    <DropShadowEffect x:Key="ShadowSmall" BlurRadius="4" ShadowDepth="1" Opacity="0.4" Color="#000000" />
    <DropShadowEffect x:Key="ShadowMedium" BlurRadius="12" ShadowDepth="3" Opacity="0.5" Color="#000000" />
    <DropShadowEffect x:Key="ShadowLarge" BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="#000000" />
    <DropShadowEffect x:Key="ShadowGlowGold" BlurRadius="16" ShadowDepth="0" Opacity="0.6" Color="{StaticResource ColorAccentGold}" />
    <DropShadowEffect x:Key="ShadowGlowRust" BlurRadius="16" ShadowDepth="0" Opacity="0.6" Color="{StaticResource ColorAccentRust}" />
    <DropShadowEffect x:Key="ShadowGlowMoss" BlurRadius="16" ShadowDepth="0" Opacity="0.6" Color="{StaticResource ColorAccentMoss}" />

    <!-- ============================================================
         ESTILOS BASE
         ============================================================ -->
    <!-- Implicit TextBlock style - applies to all TextBlocks -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="TextBlock" x:Key="TitleTextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushAccentGold}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="HeaderTextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushAccentGold}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="MonoTextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMonoNormal}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="StatValueTextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Botón base estilo dieselpunk -->
    <Style TargetType="Button" x:Key="BaseButton">
        <Setter Property="Background" Value="{StaticResource BrushButtonGradient}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Effect" Value="{StaticResource ShadowSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource BrushButtonHoverGradient}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushAccentGold}" />
                            <Setter TargetName="Border" Property="Effect" Value="{StaticResource ShadowMedium}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource BrushButtonPressedGradient}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushAccentGoldDark}" />
                            <Setter TargetName="Border" Property="Effect" Value="{StaticResource ShadowSmall}" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón primario (oro) -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{StaticResource BrushGoldGradient}" />
        <Setter Property="Foreground" Value="{StaticResource BrushBgDarkest}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentGoldDark}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Botón peligro (rojo óxido) -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" x:Key="DangerButton">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4A2A22" Offset="0" />
                    <GradientStop Color="#3A1A12" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentRust}" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccentRustLight}" />
    </Style>

    <!-- Botón pequeño para grids -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" x:Key="GridButton">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <!-- RadioButton estilo pestaña -->
    <Style TargetType="RadioButton" x:Key="TabRadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Border"
                            Background="Transparent"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushAccentGold}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushAccentGold}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushAccentGold}" />
                            <Setter TargetName="Border" Property="Background" Value="#1A1A10" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ThinScrollBar - debe definirse antes de StyledScrollViewer -->
    <Style TargetType="ScrollBar" x:Key="ThinScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Width="6" Background="{StaticResource BrushBorderLight}">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3"
                                                Margin="2"
                                                Opacity="0.6" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" />
                        </Track.IncreaseRepeatButton>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" />
                        </Track.DecreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel con borde decorativo -->
    <Style TargetType="Border" x:Key="PanelBorder">
        <Setter Property="Background" Value="{StaticResource BrushPanelGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Effect" Value="{StaticResource ShadowMedium}" />
    </Style>

    <!-- ScrollViewer estilizado -->
    <Style TargetType="ScrollViewer" x:Key="StyledScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Width="10"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Style="{StaticResource ThinScrollBar}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="1"
                                   Height="10"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Style="{StaticResource ThinScrollBar}"
                                   Orientation="Horizontal" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListBox / ItemsControl base -->
    <Style TargetType="ListBox" x:Key="StyledListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#2A2A1A" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushAccentGold}" />
                                        <Setter TargetName="Border" Property="BorderThickness" Value="1,0,0,0" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#22221A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ProgressBar para barras de recursos -->
    <Style TargetType="ProgressBar" x:Key="ResourceProgressBar">
        <Setter Property="Height" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="Background" Value="#141410" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="1"
                                    HorizontalAlignment="Left"
                                    Margin="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separador decorativo -->
    <Style TargetType="Separator" x:Key="DecorativeSeparator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="40" Height="1" Background="{StaticResource BrushBorder}" />
                        <TextBlock Text="◆" Foreground="{StaticResource BrushAccentGold}" FontSize="10" Margin="8,0" />
                        <Border Width="40" Height="1" Background="{StaticResource BrushBorder}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltip enriquecido -->
    <Style TargetType="ToolTip" x:Key="RichToolTip">
        <Setter Property="Background" Value="{StaticResource BrushPanelGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentGold}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Effect" Value="{StaticResource ShadowMedium}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <!-- Animaciones reutilizables -->
    <Storyboard x:Key="PulseAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0.4" Duration="0:0:1"
                         AutoReverse="True" RepeatBehavior="Forever" />
    </Storyboard>

    <Storyboard x:Key="GlowPulseAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius"
                         From="8" To="24" Duration="0:0:1.5"
                         AutoReverse="True" RepeatBehavior="Forever" />
    </Storyboard>

    <Storyboard x:Key="SlideInFromRight">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                         From="300" To="0" Duration="0:0:0.3"
                         DecelerationRatio="0.8" />
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.3" />
    </Storyboard>

    <Storyboard x:Key="SlideOutToRight">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                         From="0" To="300" Duration="0:0:0.2"
                         AccelerationRatio="0.8" />
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.2" />
    </Storyboard>

    <Storyboard x:Key="FadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.3" />
    </Storyboard>

    <Storyboard x:Key="FadeOut">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.2" />
    </Storyboard>

    <!-- StyledTextBox para MahApps -->
    <Style x:Key="StyledTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="#1A1A10" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushAccentGold}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrushAccentGold}" />
        <Setter Property="SelectionOpacity" Value="0.3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushAccentGold}" />
                            <Setter TargetName="Border" Property="Effect" Value="{StaticResource ShadowMedium}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushBorderLight}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StyledSlider -->
    <Style x:Key="StyledSlider" TargetType="Slider">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccentGold}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="GridRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Track x:Name="PART_Track" Grid.Row="1">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource BrushAccentGold}"
                                                     Stroke="{StaticResource BrushBorder}"
                                                     StrokeThickness="2"
                                                     Effect="{StaticResource ShadowSmall}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <Border x:Name="TrackBackground"
                                Grid.Row="1"
                                Height="6"
                                Background="#1A1A10"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Margin="9,0">
                            <Border.Clip>
                                <RectangleGeometry x:Name="TrackClip" RadiusX="3" RadiusY="3" />
                            </Border.Clip>
                            <Border x:Name="TrackFill"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource SliderWidthConverter}">
                                        <Binding ElementName="PART_Track" Path="Value" />
                                        <Binding ElementName="PART_Track" Path="Minimum" />
                                        <Binding ElementName="PART_Track" Path="Maximum" />
                                        <Binding ElementName="PART_Track" Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StyledCheckBox -->
    <Style x:Key="StyledCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckBoxBorder"
                                Width="20" Height="20"
                                Background="#1A1A10"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="2"
                                CornerRadius="3"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckMark"
                                  Data="M0,6 L6,12 L16,0"
                                  Stroke="{StaticResource BrushAccentGold}"
                                  StrokeThickness="2.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  Margin="2" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource BrushAccentGold}" />
                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="#1A1A0A" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource BrushAccentGold}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>