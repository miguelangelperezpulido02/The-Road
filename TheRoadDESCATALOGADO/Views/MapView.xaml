<UserControl x:Class="TheRoad.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TheRoad.Views"
             xmlns:vm="clr-namespace:TheRoad.ViewModels"
             xmlns:models="clr-namespace:TheRoad.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Converters/CommonConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Node Style -->
            <Style x:Key="MapNodeStyle" TargetType="local:MapNode">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:MapNode">
                            <Grid x:Name="NodeGrid" Width="{TemplateBinding NodeSize}" Height="{TemplateBinding NodeSize}">
                                <!-- Outer glow for current -->
                                <Ellipse x:Name="CurrentGlow"
                                         Width="{TemplateBinding NodeSize}"
                                         Height="{TemplateBinding NodeSize}"
                                         Fill="Transparent"
                                         Stroke="{StaticResource BrushAccentGold}"
                                         StrokeThickness="3"
                                         Opacity="0"
                                         Visibility="Collapsed">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="GlowScale" CenterX="{Binding NodeSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HalfConverter}}"
                                                        CenterY="{Binding NodeSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HalfConverter}}" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="GlowScale"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     From="1" To="1.4" Duration="0:0:1.5"
                                                                     AutoReverse="True" />
                                                    <DoubleAnimation Storyboard.TargetName="GlowScale"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     From="1" To="1.4" Duration="0:0:1.5"
                                                                     AutoReverse="True" />
                                                    <DoubleAnimation Storyboard.TargetName="CurrentGlow"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="0.8" To="0.2" Duration="0:0:1.5"
                                                                     AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>

                                <!-- Node background -->
                                <Ellipse x:Name="NodeBg"
                                         Fill="{TemplateBinding NodeColor}"
                                         Stroke="{StaticResource BrushBorder}"
                                         StrokeThickness="2"
                                         Width="{TemplateBinding NodeSize}"
                                         Height="{TemplateBinding NodeSize}" />

                                <!-- Icon -->
                                <TextBlock x:Name="NodeIcon"
                                           Text="{TemplateBinding Icon}"
                                           FontSize="{TemplateBinding IconSize}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushTextPrimary}" />

                                <!-- Visited checkmark -->
                                <Path x:Name="VisitedMark"
                                      Data="M0,0 L4,4 L10,-2"
                                      Stroke="{StaticResource BrushAccentMoss}"
                                      StrokeThickness="2.5"
                                      Width="{TemplateBinding NodeSize}"
                                      Height="{TemplateBinding NodeSize}"
                                      Stretch="Uniform"
                                      Margin="2"
                                      Visibility="Collapsed" />

                                <!-- Selection ring -->
                                <Ellipse x:Name="SelectionRing"
                                         Stroke="{StaticResource BrushAccentGold}"
                                         StrokeThickness="3"
                                         Width="{TemplateBinding NodeSize}"
                                         Height="{TemplateBinding NodeSize}"
                                         Visibility="Collapsed" />

                                <!-- Tooltip -->
                                <ToolTip x:Name="NodeTooltip"
                                         Content="{TemplateBinding ToolTipText}"
                                         Style="{StaticResource RichToolTip}"
                                         Placement="Mouse" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsCurrent" Value="True">
                                    <Setter TargetName="CurrentGlow" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="NodeBg" Property="Stroke" Value="{StaticResource BrushAccentGold}" />
                                    <Setter TargetName="NodeBg" Property="StrokeThickness" Value="3" />
                                </Trigger>
                                <Trigger Property="IsVisited" Value="True">
                                    <Setter TargetName="VisitedMark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="NodeBg" Property="Opacity" Value="0.6" />
                                </Trigger>
                                <Trigger Property="IsReachable" Value="True">
                                    <Setter TargetName="NodeBg" Property="Stroke" Value="{StaticResource BrushAccentGold}" />
                                    <Setter TargetName="NodeBg" Property="StrokeThickness" Value="2.5" />
                                </Trigger>
                                <Trigger Property="IsDestination" Value="True">
                                    <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="NodeBg" Property="Fill" Value="{StaticResource BrushAccentGold}" />
                                    <Setter TargetName="NodeIcon" Property="Foreground" Value="{StaticResource BrushBgDarkest}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Route Style -->
            <Style x:Key="MapRouteStyle" TargetType="Path">
                <Setter Property="StrokeThickness" Value="3" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource BrushBgDarkest}">
        <!-- Zoom/Pan Container -->
        <Border x:Name="MapBorder"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                Background="#0A0A0A"
                ClipToBounds="True"
                MouseWheel="MapBorder_MouseWheel"
                MouseLeftButtonDown="MapBorder_MouseLeftButtonDown"
                MouseLeftButtonUp="MapBorder_MouseLeftButtonUp"
                MouseMove="MapBorder_MouseMove"
                MouseLeave="MapBorder_MouseLeave">

            <Canvas x:Name="MapCanvas"
                    Width="1400" Height="760"
                    RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MapScaleTransform" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="MapTranslateTransform" X="0" Y="0" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Routes Layer -->
                <Canvas x:Name="RoutesCanvas" />

                <!-- Travel Animation Path -->
                <Path x:Name="TravelPath"
                      Stroke="{StaticResource BrushAccentGold}"
                      StrokeThickness="4"
                      StrokeDashArray="10 5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.8"
                      Visibility="Collapsed">
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Path.Loaded">
                            <BeginStoryboard x:Name="TravelAnimationStoryboard">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                     From="0" To="100"
                                                     Duration="0:0:2"
                                                     RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>

                <!-- Travel Vehicle Marker -->
                <Ellipse x:Name="TravelVehicle"
                         Width="16" Height="16"
                         Fill="{StaticResource BrushAccentGold}"
                         Stroke="{StaticResource BrushBgDarkest}"
                         StrokeThickness="2"
                         Visibility="Collapsed"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="VehicleTranslate" X="-8" Y="-8" />
                            <RotateTransform x:Name="VehicleRotate" Angle="0" />
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Nodes Layer -->
                <Canvas x:Name="NodesCanvas" />
            </Canvas>
        </Border>

        <!-- Minimap Overlay -->
        <Border x:Name="MinimapBorder"
                Width="180" Height="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="12"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                Background="#1A1A1A"
                Effect="{StaticResource ShadowMedium}"
                Visibility="Visible">
            <Grid>
                <Canvas x:Name="MinimapCanvas" Width="180" Height="100" />
                <Border x:Name="MinimapViewport"
                        BorderBrush="{StaticResource BrushAccentGold}"
                        BorderThickness="2"
                        Background="#80D8A545"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- Zoom Controls -->
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="12"
                    Orientation="Vertical">
            <Button Content="+" Click="BtnZoomIn_Click" Style="{StaticResource GridButton}" Width="36" Height="36" ToolTip="Acercar (Ctrl+Rueda)" />
            <Button Content="−" Click="BtnZoomOut_Click" Style="{StaticResource GridButton}" Width="36" Height="36" Margin="0,4,0,0" ToolTip="Alejar (Ctrl+Rueda)" />
            <Button Content="⌂" Click="BtnResetView_Click" Style="{StaticResource GridButton}" Width="36" Height="36" Margin="0,4,0,0" ToolTip="Vista inicial (Espacio)" />
        </StackPanel>

        <!-- Legend -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12,50,12,0"
                Style="{StaticResource PanelBorder}"
                Padding="12"
                MinWidth="160">
            <StackPanel>
                <TextBlock Text="LEYENDA" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,8" FontSize="11" />
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Ellipse Width="12" Height="12" Fill="{StaticResource BrushAccentGold}" Stroke="{StaticResource BrushBorder}" StrokeThickness="1" VerticalAlignment="Center" />
                    <TextBlock Text="Ubicación actual" Style="{StaticResource MonoTextBlock}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Ellipse Width="12" Height="12" Fill="{StaticResource BrushAccentGold}" Stroke="{StaticResource BrushAccentGold}" StrokeThickness="3" VerticalAlignment="Center" />
                    <TextBlock Text="Destino seleccionado" Style="{StaticResource MonoTextBlock}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Ellipse Width="12" Height="12" Fill="#555555" Stroke="{StaticResource BrushBorder}" StrokeThickness="1" VerticalAlignment="Center" Opacity="0.6" />
                    <Path Data="M0,0 L4,4 L10,-2" Stroke="{StaticResource BrushAccentMoss}" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="Visitado" Style="{StaticResource MonoTextBlock}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Ellipse Width="12" Height="12" Fill="#333333" Stroke="{StaticResource BrushAccentGold}" StrokeThickness="2" VerticalAlignment="Center" />
                    <TextBlock Text="Alcanzable" Style="{StaticResource MonoTextBlock}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Ellipse Width="12" Height="12" Fill="#333333" Stroke="{StaticResource BrushBorder}" StrokeThickness="1" VerticalAlignment="Center" Opacity="0.4" />
                    <TextBlock Text="No visitado" Style="{StaticResource MonoTextBlock}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Separator Style="{StaticResource DecorativeSeparator}" Margin="0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Rectangle Width="20" Height="4" Fill="{StaticResource BrushAccentGold}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Autopista" Style="{StaticResource MonoTextBlock}" FontSize="9" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Rectangle Width="20" Height="2" Fill="{StaticResource BrushBorderLight}" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill">
                                    <Setter.Value>
                                        <DrawingBrush Viewport="0,0,10,2" ViewportUnits="Absolute" TileMode="Tile">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="{StaticResource BrushBorderLight}">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,5,2" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <TextBlock Text="Secundaria" Style="{StaticResource MonoTextBlock}" FontSize="9" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Destination Info Panel -->
        <Border x:Name="InfoPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="12"
                Style="{StaticResource PanelBorder}"
                Padding="12"
                MinWidth="280"
                MaxWidth="350"
                Visibility="{Binding DestinoSeleccionadoId, Converter={StaticResource NullToVis}}">
            <StackPanel>
                <TextBlock x:Name="InfoTitle" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,4" />
                <TextBlock x:Name="InfoRisk" Style="{StaticResource MonoTextBlock}" FontSize="10" Margin="0,0,0,8" />
                <Separator Style="{StaticResource DecorativeSeparator}" Margin="0,4" />
                <TextBlock x:Name="InfoRoutes" FontSize="11" TextWrapping="Wrap" />
                <Separator Style="{StaticResource DecorativeSeparator}" Margin="0,4" />
                <TextBlock x:Name="InfoDesc" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>